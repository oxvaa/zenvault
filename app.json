{
  "expo": {
    "name": "Zenvault Bank & Co.",
    "slug": "zenvault-bank-co",
    "version": "4.6.1",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Povolte Zenvault ověřit vaši identitu pomocí Face ID."
        }
      ],
      "expo-secure-store"
    ]
  }
}
